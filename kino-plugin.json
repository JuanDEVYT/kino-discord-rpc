{
  "id": "discord-rpc",
  "name": "Discord RPC",
  "version": "1.0.12",
  "apiVersion": 13,
  "entry": "plugin.js",
  "hosts": [
    "discord.com",
    "gateway.discord.gg",
    "image.tmdb.org"
  ],
  "capabilities": ["socket", "tracking", "resolve", "search"],
  "panel": {
    "label": "Discord RPC",
    "labelEn": "Discord RPC",
    "icon": "bolt"
  },
  "settings": [
    {
      "key": "discord_token",
      "type": "password",
      "label": "Token de Discord",
      "labelEn": "Discord token",
      "hint": "Vincula tu cuenta con el botón de abajo, o pega el token manualmente",
      "hintEn": "Link your account below, or paste the token manually",
      "sync": false
    },
    {
      "key": "link_account",
      "type": "action",
      "label": "Vincular cuenta de Discord",
      "labelEn": "Link Discord account"
    },
    {
      "key": "unlink_account",
      "type": "action",
      "label": "Desvincular cuenta",
      "labelEn": "Unlink account"
    },
    {
      "key": "discord_status",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "test_status",
      "type": "action",
      "label": "Probar estado ahora",
      "labelEn": "Test status now",
      "hint": "Envía un estado de prueba a Discord; se quita solo en un minuto",
      "hintEn": "Sends a test status to Discord; it clears itself in a minute"
    },
    {
      "key": "persist_status",
      "type": "toggle",
      "label": "Estado personalizado con lo que ves",
      "labelEn": "Custom status with what you watch",
      "hint": "Duradero: escribe tu estado de Discord con el título mientras reproduces",
      "hintEn": "Lasts: writes your Discord status with the title while playing",
      "default": true
    },
    {
      "key": "show_button",
      "type": "select",
      "label": "Botón en Discord",
      "labelEn": "Discord button",
      "options": [
        { "value": "install", "label": "Instalar Kino", "labelEn": "Install Kino" },
        { "value": "none",    "label": "Sin botón",     "labelEn": "No button" }
      ],
      "default": "install"
    }
  ],
  "enhancements": {
    "20": {
      "visualBrowser": true
    }
  }
}
